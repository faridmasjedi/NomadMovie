{
  "name": "nomadmovie",
  "private": true,
  "version": "2.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "licenses": "node scripts/licenses.mjs",
    "build:electron": "esbuild electron/main.ts --bundle --platform=node --format=esm --packages=external --target=node20 --outfile=dist-electron/main.mjs && esbuild electron/preload.ts --bundle --platform=node --format=cjs --external:electron --target=node20 --outfile=dist-electron/preload.cjs",
    "app": "npm run build && npm run build:electron && electron .",
    "dist": "npm run build && npm run build:electron && electron-builder --publish never",
    "dist:mac": "npm run build && npm run build:electron && electron-builder --mac --publish never",
    "demos": "node tools/demos/demos.mjs && node tools/demos/finish.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "electron-updater": "^6.8.11",
    "express": "^4.21.2",
    "ffmpeg-static": "^5.2.0"
  },
  "devDependencies": {
    "@fontsource/bebas-neue": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/lalezar": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@fontsource/roboto-mono": "^5.3.0",
    "@fontsource/vazirmatn": "^5.3.0",
    "@huggingface/transformers": "^4.3.1",
    "@types/express": "^4.17.21",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^44.9.3",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "gl-transitions": "^1.74.0",
    "lottie-web": "^5.13.0",
    "mp4-muxer": "^5.1.5",
    "mp4box": "^2.4.1",
    "puppeteer-core": "^23.10.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "zustand": "^4.5.5"
  },
  "productName": "NomadMovie",
  "description": "Free, open-source video editor with AI: timeline editing, motion graphics, masks and AI subject cut-out, and an assistant that edits from chat.",
  "author": {
    "name": "Farid Masjedi",
    "email": "farid.masjedi1985@gmail.com"
  },
  "main": "dist-electron/main.mjs",
  "build": {
    "appId": "com.faridmasjedi.nomadmovie",
    "productName": "NomadMovie",
    "copyright": "Copyright © 2026 Farid Masjedi",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "mac": {
      "category": "public.app-category.video",
      "target": [
        {
          "target": "dmg"
        },
        {
          "target": "zip"
        }
      ],
      "icon": "build/icon.png",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "NomadMovie uses the microphone to record voice-overs."
      }
    },
    "dmg": {
      "title": "NomadMovie ${version}"
    },
    "win": {
      "target": [
        {
          "target": "nsis"
        },
        {
          "target": "zip"
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-${version}-windows-setup.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "zip"
      ],
      "category": "AudioVideo;Video;AudioVideoEditing",
      "icon": "build/icon.png",
      "maintainer": "Farid Masjedi <farid.masjedi1985@gmail.com>",
      "synopsis": "Video editor with AI"
    },
    "afterSign": "build/adhoc-sign.cjs",
    "publish": [
      {
        "provider": "github",
        "owner": "faridmasjedi",
        "repo": "NomadMovie"
      }
    ],
    "extraResources": [
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "LICENSE",
        "to": "LICENSE.txt"
      }
    ]
  },
  "license": "MIT",
  "homepage": "https://github.com/faridmasjedi/NomadMovie",
  "repository": {
    "type": "git",
    "url": "https://github.com/faridmasjedi/NomadMovie.git"
  },
  "bugs": {
    "url": "https://github.com/faridmasjedi/NomadMovie/issues"
  }
}
